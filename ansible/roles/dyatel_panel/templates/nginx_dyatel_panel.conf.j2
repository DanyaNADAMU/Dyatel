# ==============================================================================
# Dyatel Panel Virtual Host Configuration
# Panel: {{ dyatel_panel_domain }} (same-origin /api/v1/ mount)
# ==============================================================================

# HTTP -> HTTPS Redirection
server {
    listen {{ dyatel_panel_nginx_http_port }};
    listen [::]:{{ dyatel_panel_nginx_http_port }};

    server_name {{ dyatel_panel_domain }};

    location / {
        return 301 https://{{ dyatel_panel_domain }}$request_uri;
    }
}

# Canonical Dyatel Panel (static SPA) + same-origin core API proxy
server {
{% if not (dyatel_panel_nginx_behind_xray | bool) %}
    listen {{ dyatel_panel_nginx_https_port }} ssl http2;
    listen [::]:{{ dyatel_panel_nginx_https_port }} ssl http2;
{% endif %}
    # Loopback bridge listener for the berg L4 SNI multiplexer
    listen 127.0.0.1:8000 ssl http2{% if dyatel_panel_nginx_behind_xray | bool %} proxy_protocol{% endif %};

    server_name {{ dyatel_panel_domain }};

{% if dyatel_panel_nginx_behind_xray | bool %}
    # Recover real client IPs from the PROXY protocol v2 header
    set_real_ip_from {{ dyatel_panel_real_ip_from }};
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
{% endif %}

    ssl_certificate {{ dyatel_panel_ssl_cert_file }};
    ssl_certificate_key {{ dyatel_panel_ssl_key_file }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Core API (RFC §5): plain loopback proxy, Authorization header
    # passes through untouched. Long paths: rendered tunnel configs.
    location /api/v1/ {
        proxy_pass http://{{ dyatel_panel_core_listen_ip }}:{{ dyatel_panel_core_port }};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Never let a client assert an identity to the core: the header would
        # be plain text, and the core trusts it whenever that path is enabled.
        proxy_set_header X-Dyatel-Sub "";

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Static SPA assets with immutable content-hash filenames
    location /assets/ {
        root {{ dyatel_panel_webroot }};
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA shell: everything else falls back to index.html
    location / {
        root {{ dyatel_panel_webroot }};
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
