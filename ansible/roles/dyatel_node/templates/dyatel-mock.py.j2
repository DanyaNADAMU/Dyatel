#!/usr/bin/env python3
"""
Dyatel Mock Server for Port & NAT Traversal Verification
Listens on TCP port {{ dyatel_node_game_port }} across dual-stack.
Responds with an identifiable string for automated testing.
"""
import socket
import select
import sys

PORT = {{ dyatel_node_game_port }}

def main():
    servers = []

    # IPv4 listener
    try:
        s4 = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s4.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s4.bind(('0.0.0.0', PORT))
        s4.listen(5)
        servers.append(s4)
    except Exception as e:
        print(f"Failed to bind IPv4: {e}", file=sys.stderr)

    # IPv6 listener
    try:
        s6 = socket.socket(socket.AF_INET6, socket.SOCK_STREAM)
        s6.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s6.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
        s6.bind(('::', PORT))
        s6.listen(5)
        servers.append(s6)
    except Exception as e:
        print(f"Failed to bind IPv6: {e}", file=sys.stderr)

    print(f"Dyatel mock server listening on port {PORT}...")

    while True:
        readable, _, _ = select.select(servers, [], [])
        for s in readable:
            conn, addr = s.accept()
            try:
                _ = conn.recv(1024)
                conn.sendall(b"PONG_DYATEL_VERIFIED\n")
            except Exception:
                pass
            finally:
                conn.close()

if __name__ == '__main__':
    main()
