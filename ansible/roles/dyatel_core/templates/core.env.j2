# Managed by Ansible (role dyatel_core). Runtime environment for dyatel-core.
# Layer 1 config only; secrets come from vault bindings in defaults (Infra §6).
# NOTE: systemd EnvironmentFile performs NO variable expansion and NO $$
# unescaping (verified empirically on systemd 257): values pass through
# verbatim, so argon2id PHC hashes ($argon2id$v=19$...) are safe as-is.
DYATEL_BIND={{ dyatel_core_bind }}
{% if dyatel_core_db_host.startswith('/') %}
DYATEL_DB_DSN=postgres:///{{ dyatel_core_db_name }}?host={{ dyatel_core_db_host }}&user={{ dyatel_core_db_user }}&password={{ dyatel_core_db_password | urlencode }}&pool_max_conns={{ dyatel_core_db_pool_max }}
{% else %}
DYATEL_DB_DSN=postgres://{{ dyatel_core_db_user }}:{{ dyatel_core_db_password | urlencode }}@{{ dyatel_core_db_host }}/{{ dyatel_core_db_name }}?sslmode=disable&pool_max_conns={{ dyatel_core_db_pool_max }}
{% endif %}
DYATEL_RECONCILE_EVERY={{ dyatel_core_reconcile_every }}
DYATEL_NODE={{ dyatel_core_node }}
DYATEL_TUNNEL_V4={{ dyatel_core_tunnel_v4 }}
DYATEL_TUNNEL_V6={{ dyatel_core_tunnel_v6 }}
DYATEL_WG_PORTS_MIN={{ dyatel_core_wg_ports_min }}
DYATEL_WG_PORTS_MAX={{ dyatel_core_wg_ports_max }}
DYATEL_AWG_PORTS_MIN={{ dyatel_core_awg_ports_min }}
DYATEL_AWG_PORTS_MAX={{ dyatel_core_awg_ports_max }}
DYATEL_XRAY_PORTS_MIN={{ dyatel_core_xray_ports_min }}
DYATEL_XRAY_PORTS_MAX={{ dyatel_core_xray_ports_max }}
DYATEL_PUBLIC_ENDPOINT={{ dyatel_core_public_endpoint }}
DYATEL_CORE_LISTEN_IP={{ dyatel_core_core_listen_ip }}
DYATEL_WG_CONFIG_PATH={{ dyatel_core_wg_config_path }}
DYATEL_WG_IFNAME={{ dyatel_core_wg_ifname }}
DYATEL_UFW_PATH={{ dyatel_core_ufw_path }}
DYATEL_OIDC_INTROSPECTION_URL={{ dyatel_core_oidc_introspection_url }}
{% if dyatel_core_oidc_client_id %}
DYATEL_OIDC_CLIENT_ID={{ dyatel_core_oidc_client_id }}
DYATEL_OIDC_CLIENT_SECRET={{ dyatel_core_oidc_client_secret }}
{% endif %}
DYATEL_OIDC_ADMIN_GROUP={{ dyatel_core_oidc_admin_group }}
{% if dyatel_core_fallback_admin_user %}
DYATEL_FALLBACK_ADMIN_USER={{ dyatel_core_fallback_admin_user }}
DYATEL_FALLBACK_ADMIN_HASH={{ dyatel_core_fallback_admin_hash }}
{% endif %}
DYATEL_DNS_ZONE={{ dyatel_core_dns_zone }}
